<Window x:Class="AudioSwitcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AudioSwitcher.Controls"
        Title="AudioSwitcher" Width="1220" Height="760" MinWidth="1220" MaxWidth="1220" MinHeight="760" MaxHeight="760" WindowStyle="None" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="#090E18" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="Light" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonDown="PointerDown" PreviewMouseLeftButtonUp="PointerUp" PreviewMouseMove="PointerMove" PreviewMouseRightButtonDown="IgnoreRightButton" PreviewMouseRightButtonUp="IgnoreRightButton">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TvCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="20,14"/><Setter Property="Height" Value="90"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="FocusFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><Grid><Border Height="1" Background="{DynamicResource Line}" VerticalAlignment="Bottom"/><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="0,0,0,1"/></Grid></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TvTab" TargetType="controls:SectionButton" BasedOn="{StaticResource SectionTab}">
      <Setter Property="FontSize" Value="23"/><Setter Property="Height" Value="72"/><Setter Property="Width" Value="286"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="24,0"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:SectionButton">
        <Border x:Name="SelectionFrame" BorderBrush="Transparent" BorderThickness="2" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OverlayCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource DialogSurface}"/><Setter Property="BorderBrush" Value="#5B606A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="28"/><Setter Property="Width" Value="650"/><Setter Property="MaxHeight" Value="574"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,66,56,54"/></Style>
    <Style x:Key="TvList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Style="{StaticResource DeviceScrollViewer}" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="AppRoot" Background="{DynamicResource WindowSurface}" ClipToBounds="True">
    <Ellipse Width="780" Height="780" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-390,0,0" IsHitTestVisible="False" Opacity="0.42"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#C5AFA8" Offset="0"/><GradientStop Color="#4A454D" Offset="0.38"/><GradientStop Color="#004A454D" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><BlurEffect Radius="72"/></Ellipse.Effect></Ellipse>
    <Ellipse Width="820" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-270,0,0,-330" IsHitTestVisible="False" Opacity="0.38"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#7D8D98" Offset="0"/><GradientStop Color="#2F424D" Offset="0.4"/><GradientStop Color="#002F424D" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><BlurEffect Radius="78"/></Ellipse.Effect></Ellipse>
    <Border x:Name="WindowFrame" Background="Transparent" Padding="56,40,56,24" CornerRadius="0" BorderThickness="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <TextBlock Text="AudioSwitcher" FontSize="40" FontWeight="Light" VerticalAlignment="Top"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid x:Name="SectionHeader" Grid.Column="0">
            <StackPanel VerticalAlignment="Top" Margin="0,22,0,0">
              <controls:SectionButton x:Name="ControlTab" Style="{StaticResource TvTab}" Click="ControlClick" Content="Управление" AutomationProperties.Name="Управление"/>
              <controls:SectionButton x:Name="RunningTab" Style="{StaticResource TvTab}" Click="RunningClick" Content="Запущенные" AutomationProperties.Name="Запущенные приложения"/>
              <controls:SectionButton x:Name="LaunchTab" Style="{StaticResource TvTab}" Click="LaunchClick" Content="Для запуска" AutomationProperties.Name="Программы для запуска"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Bottom" Margin="24,0,0,18" Text="LB  RB   разделы" Foreground="{DynamicResource MutedText}" FontSize="14"/>
          </Grid>
          <Grid x:Name="ControlSurface" Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Быстрые действия" FontSize="29" FontWeight="Light"/><TextBlock Text="Выберите параметр для изменения" Margin="0,8,0,0" Foreground="{DynamicResource MutedText}" FontSize="16"/></StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
              <Button x:Name="AudioControlCard" Style="{StaticResource TvCard}" Click="AudioCardClick" AutomationProperties.Name="Выбрать устройство звука"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Устройство звука" FontSize="22" VerticalAlignment="Center"/><TextBlock x:Name="AudioSummary" Grid.Column="1" Text="Загрузка…" FontSize="17" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="390"/></Grid></Button>
              <Button x:Name="DisplayControlCard" Style="{StaticResource TvCard}" Click="DisplayCardClick" AutomationProperties.Name="Выбрать основной экран"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Основной экран" FontSize="22" VerticalAlignment="Center"/><TextBlock x:Name="DisplaySummary" Grid.Column="1" Text="Загрузка…" FontSize="17" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="390"/></Grid></Button>
            </StackPanel>
          </Grid>
          <controls:ProgramsView x:Name="Programs" Grid.Column="2" Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="2"><TextBlock x:Name="Status" Text="Готово" FontSize="14" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="340,0,420,0"/><StackPanel x:Name="ControllerHints" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PrimaryCommand" Content="A  выбрать" Click="PrimaryCommandClick"/><Button x:Name="SecondaryCommand" Content="X  действие" Click="SecondaryCommandClick"/><Button x:Name="CreateCommand" Content="Y  добавить" Click="CreateCommandClick"/><Button x:Name="SettingsCommand" Content="☰  настройки" Click="SettingsCommandClick"/><Button x:Name="BackCommand" Content="B  назад" Click="BackCommandClick"/></StackPanel></Grid>
      </Grid>
    </Border>
    <Border x:Name="OverlayShade" Background="#B5080A0D" Visibility="Collapsed">
      <Grid>
        <Border x:Name="DevicePickerOverlay" Style="{StaticResource OverlayCard}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="2,0,2,20"><TextBlock x:Name="PickerTitle" Text="Выберите устройство" FontSize="29" FontWeight="Light"/><TextBlock x:Name="PickerSubtitle" Margin="0,7,0,0" Foreground="{DynamicResource MutedText}" FontSize="16"/></StackPanel><Grid Grid.Row="1"><ListBox x:Name="Devices" Background="Transparent" BorderThickness="0" Padding="0" PreviewMouseLeftButtonUp="ApplyMouseClick" AutomationProperties.Name="Доступные устройства"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="21" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayDetails}" FontSize="15" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Marker}" Margin="24,0,0,0" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" FontSize="14"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="Empty" Text="Нет доступных устройств" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Visibility="Collapsed"/></Grid></Grid></Border>
        <Border x:Name="SettingsSurface" Style="{StaticResource OverlayCard}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="2,0,2,20"><TextBlock Text="Настройки" FontSize="29" FontWeight="Light"/><TextBlock Text="После переноса окна на главный экран" Foreground="{DynamicResource MutedText}" FontSize="16" Margin="0,7,0,0"/></StackPanel><ListBox x:Name="SettingsChoices" Grid.Row="1" Background="Transparent" BorderThickness="0" PreviewMouseLeftButtonUp="SettingsMouseClick" AutomationProperties.Name="Поведение после переноса"><ListBoxItem Tag="Keep"><StackPanel><TextBlock Text="Оставить AudioSwitcher открытым" FontSize="21"/><TextBlock Text="Окно переместится без передачи фокуса" Foreground="{DynamicResource MutedText}" FontSize="15" Margin="0,4,0,0"/></StackPanel></ListBoxItem><ListBoxItem Tag="Close"><StackPanel><TextBlock Text="Переключиться на приложение" FontSize="21"/><TextBlock Text="AudioSwitcher закроется после успешного переноса" Foreground="{DynamicResource MutedText}" FontSize="15" Margin="0,4,0,0"/></StackPanel></ListBoxItem></ListBox></Grid></Border>
        <Border x:Name="DetailsSurface" Style="{StaticResource OverlayCard}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Не удалось выполнить действие" FontSize="29" FontWeight="Light" Margin="2,0,2,20"/><ScrollViewer x:Name="ErrorScroll" Grid.Row="1" Style="{StaticResource DeviceScrollViewer}"><TextBlock x:Name="FullError" TextWrapping="Wrap" FontSize="17" Foreground="{DynamicResource MutedText}"/></ScrollViewer></Grid></Border>
      </Grid>
    </Border>
  </Grid>
</Window>
