<Window x:Class="AudioSwitcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AudioSwitcher.Controls"
        Title="AudioSwitcher" Width="1500" Height="844" WindowStyle="None" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="#0A0E18" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="{DynamicResource Font28}" FontWeight="350" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonDown="PointerDown" PreviewMouseLeftButtonUp="PointerUp" PreviewMouseMove="PointerMove" PreviewMouseRightButtonDown="RightPointerDown" PreviewMouseRightButtonUp="RightPointerUp">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TvCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="18,10"/><Setter Property="Height" Value="79"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="FocusFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="{DynamicResource FocusBorderThickness}" CornerRadius="{DynamicResource FocusCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource HoverSurface}"/><Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TvTab" TargetType="controls:SectionButton" BasedOn="{StaticResource SectionTab}">
      <Setter Property="FontSize" Value="{DynamicResource Font38}"/><Setter Property="Height" Value="84"/><Setter Property="Width" Value="311"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="23,0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:SectionButton">
        <Border x:Name="SelectionFrame" BorderBrush="Transparent" BorderThickness="{DynamicResource FocusBorderThickness}" CornerRadius="{DynamicResource FocusCornerRadius}" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="SectionMarker" Width="5" Height="5" Fill="{DynamicResource SelectedText}" Margin="0,0,13,0" VerticalAlignment="Center" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="SectionMarker" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/><Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OverlayCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DialogSurface}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="23"/><Setter Property="Width" Value="263"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,40,399,94"/>
    </Style>
    <Style x:Key="SettingsPane" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="884"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="Margin" Value="506,135,0,94"/>
    </Style>
    <Style x:Key="GamepadBadge" TargetType="Border">
      <Setter Property="MinWidth" Value="{DynamicResource BadgeSize}"/><Setter Property="Height" Value="{DynamicResource BadgeSize}"/><Setter Property="Padding" Value="4,0"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource MutedText}"/><Setter Property="Background" Value="#09000000"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource Font20}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <DataTemplate x:Key="CommandHintTemplate">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource GamepadBadge}"><TextBlock Style="{StaticResource BadgeText}" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/></Border>
        <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource Font28}"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="CommandHint" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="ContentTemplate" Value="{StaticResource CommandHintTemplate}"/><Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="5,0,0,0"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="SettingsToggleRow" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Height" Value="79"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{DynamicResource FocusBorderThickness}" CornerRadius="{DynamicResource FocusCornerRadius}" Padding="18,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Переключаться на приложение" FontSize="{DynamicResource Font38}" FontWeight="350"/><TextBlock Text="AudioSwitcher закроется после успешного переноса" FontSize="{DynamicResource Font24}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="21,0,0,0"><TextBlock x:Name="ToggleState" Text="Выкл." FontSize="{DynamicResource Font24}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,11,0"/><Border x:Name="Track" Width="49" Height="24" CornerRadius="12" Background="#40434D" VerticalAlignment="Center"><Border x:Name="Thumb" Width="19" Height="19" CornerRadius="10" Background="{DynamicResource Text}" HorizontalAlignment="Left" Margin="3,0"/></Border></StackPanel>
            <Border Height="1" Background="{DynamicResource Line}" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#60636D"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="ToggleState" Property="Text" Value="Вкл."/><Setter TargetName="ToggleState" Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SingleChoiceItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="{DynamicResource FocusBorderThickness}" CornerRadius="{DynamicResource FocusCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TvList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="ItemContainerStyle" Value="{StaticResource SingleChoiceItem}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Style="{StaticResource DeviceScrollViewer}" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="AppRoot" Background="{DynamicResource WindowSurface}" ClipToBounds="True">
    <Image x:Name="DecorativeBackground" Source="/AudioSwitcher;component/Assets/ps5-settings-background.png" Stretch="UniformToFill" IsHitTestVisible="False" Margin="-15">
      <Image.Effect><BlurEffect Radius="15" RenderingBias="Quality"/></Image.Effect>
    </Image>
    <Border x:Name="WindowFrame" Panel.ZIndex="1" Background="Transparent" Padding="80,60,110,76" CornerRadius="0" BorderThickness="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="75"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="AudioSwitcher" FontSize="36" FontWeight="350" VerticalAlignment="Top"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="364"/><ColumnDefinition Width="63"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid x:Name="SectionHeader" Grid.Column="0">
            <StackPanel VerticalAlignment="Top" Margin="53,8,0,0">
              <controls:SectionButton x:Name="ControlTab" Style="{StaticResource TvTab}" Click="ControlClick" Content="Управление" AutomationProperties.Name="Управление"/>
              <controls:SectionButton x:Name="RunningTab" Style="{StaticResource TvTab}" Click="RunningClick" Content="Запущенные" AutomationProperties.Name="Запущенные приложения"/>
              <controls:SectionButton x:Name="LaunchTab" Style="{StaticResource TvTab}" Click="LaunchClick" Content="Для запуска" AutomationProperties.Name="Программы для запуска"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="ControlSurface" Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Быстрые действия" FontSize="26" FontWeight="350"/>
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
              <Button x:Name="AudioControlCard" Style="{StaticResource TvCard}" Click="AudioCardClick" AutomationProperties.Name="Выбрать устройство звука"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Устройство звука" FontSize="{DynamicResource Font38}" VerticalAlignment="Center"/><TextBlock x:Name="AudioSummary" Grid.Column="1" Text="Загрузка…" FontSize="{DynamicResource Font28}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="325"/></Grid></Button>
              <Border x:Name="ControlRowDivider" Height="1" Background="{DynamicResource Line}" Margin="18,0" SnapsToDevicePixels="True"/>
              <Button x:Name="DisplayControlCard" Style="{StaticResource TvCard}" Click="DisplayCardClick" AutomationProperties.Name="Выбрать основной экран"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Основной экран" FontSize="{DynamicResource Font38}" VerticalAlignment="Center"/><TextBlock x:Name="DisplaySummary" Grid.Column="1" Text="Загрузка…" FontSize="{DynamicResource Font28}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="325"/></Grid></Button>
            </StackPanel>
          </Grid>
          <controls:ProgramsView x:Name="Programs" Grid.Column="2" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="OverlayShade" Panel.ZIndex="2" Background="Transparent" Visibility="Collapsed">
      <Grid>
        <Border x:Name="ModalBackdrop" Background="#B5080A0D" Visibility="{Binding Visibility, ElementName=DevicePickerOverlay}"/>
        <Border x:Name="ErrorBackdrop" Background="#B5080A0D" Visibility="{Binding Visibility, ElementName=DetailsSurface}"/>
        <Border x:Name="DevicePickerOverlay" Style="{StaticResource OverlayCard}" Width="450" Margin="0,40,40,94" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="4,5,4,21"><TextBlock x:Name="PickerTitle" Text="Выберите устройство" FontSize="26" FontWeight="350" TextWrapping="Wrap"/><TextBlock x:Name="PickerSubtitle" Margin="0,6,0,0" Foreground="{DynamicResource MutedText}" FontSize="{DynamicResource Font24}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="1"><ListBox x:Name="Devices" Background="Transparent" BorderThickness="0" Padding="0" PreviewMouseLeftButtonUp="ApplyMouseClick" AutomationProperties.Name="Доступные устройства"><ListBox.ItemTemplate><DataTemplate><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Font34}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Marker}" Margin="15,0,0,0" Foreground="{DynamicResource MutedText}" FontSize="{DynamicResource Font20}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DisplayDetails}" FontSize="{DynamicResource Font22}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="Empty" Text="Нет доступных устройств" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed"/></Grid></Grid></Border>
        <Border x:Name="SettingsSurface" Style="{StaticResource SettingsPane}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Настройки" FontSize="26" FontWeight="350"/><TextBlock Text="После переноса окна на главный экран" Foreground="{DynamicResource MutedText}" FontSize="{DynamicResource Font28}" Margin="0,6,0,0"/></StackPanel><Grid Grid.Row="1"><ListBox x:Name="SettingsChoices" Visibility="Collapsed" AutomationProperties.Name="Поведение после переноса"><ListBoxItem Tag="Keep"/><ListBoxItem Tag="Close"/></ListBox><ToggleButton x:Name="SettingsToggle" Style="{StaticResource SettingsToggleRow}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Click="SettingsToggleClick" AutomationProperties.Name="Переключаться на приложение"/></Grid></Grid></Border>
        <Border x:Name="DetailsSurface" Style="{StaticResource OverlayCard}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Не удалось выполнить действие" FontSize="26" FontWeight="350" Margin="4,5,4,21" TextWrapping="Wrap"/><ScrollViewer x:Name="ErrorScroll" Grid.Row="1" Style="{StaticResource DeviceScrollViewer}"><TextBlock x:Name="FullError" TextWrapping="Wrap" FontSize="{DynamicResource Font24}" Foreground="{DynamicResource MutedText}"/></ScrollViewer></Grid></Border>
      </Grid>
    </Border>
    <Grid x:Name="FooterSurface" Panel.ZIndex="3" Height="48" Margin="80,0,110,28" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="364"/><ColumnDefinition Width="63"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Grid.Column="0" Text="Готово" FontSize="{DynamicResource Font24}" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="313"/><StackPanel x:Name="ControllerHints" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PrimaryCommand" Style="{StaticResource CommandHint}" Tag="A" Content="выбрать" Click="PrimaryCommandClick"/><Button x:Name="SecondaryCommand" Style="{StaticResource CommandHint}" Tag="X" Content="действие" Click="SecondaryCommandClick"/><Button x:Name="CreateCommand" Style="{StaticResource CommandHint}" Tag="Y" Content="добавить" Click="CreateCommandClick"/><Button x:Name="SettingsCommand" Style="{StaticResource CommandHint}" Tag="Menu" Content="настройки" Click="SettingsCommandClick"/><Button x:Name="BackCommand" Style="{StaticResource CommandHint}" Tag="B" Content="назад" Click="BackCommandClick"/></StackPanel></Grid>
  </Grid>
</Window>
