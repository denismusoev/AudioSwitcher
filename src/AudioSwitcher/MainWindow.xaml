<Window x:Class="AudioSwitcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AudioSwitcher.Controls"
        Title="AudioSwitcher" Width="1220" Height="760" MinWidth="1220" MaxWidth="1220" MinHeight="760" MaxHeight="760" WindowStyle="None" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="#111318" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="18" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonDown="PointerDown" PreviewMouseLeftButtonUp="PointerUp" PreviewMouseMove="PointerMove" PreviewMouseRightButtonDown="IgnoreRightButton" PreviewMouseRightButtonUp="IgnoreRightButton">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TvCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="24,20"/><Setter Property="MinHeight" Value="118"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="#15191F" BorderBrush="#50565F" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Card" Property="BorderThickness" Value="3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Card" Property="Background" Value="#1D222A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="TvTab" TargetType="Button" BasedOn="{StaticResource SectionTab}"><Setter Property="FontSize" Value="24"/><Setter Property="MinHeight" Value="50"/><Setter Property="Margin" Value="0,0,38,0"/></Style>
    <Style x:Key="OverlayCard" TargetType="Border"><Setter Property="Background" Value="#F5222429"/><Setter Property="BorderBrush" Value="#646A74"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="32"/><Setter Property="Width" Value="820"/><Setter Property="MaxHeight" Value="560"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="TvList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Style="{StaticResource DeviceScrollViewer}" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border x:Name="WindowFrame" Background="{DynamicResource WindowSurface}" Padding="54,38,54,28" CornerRadius="12" BorderBrush="#3C424B" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
      <Grid x:Name="SectionHeader"><StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <controls:SectionButton x:Name="ControlTab" Style="{StaticResource TvTab}" Click="ControlClick" Content="Управление" AutomationProperties.Name="Управление"/>
        <controls:SectionButton x:Name="RunningTab" Style="{StaticResource TvTab}" Click="RunningClick" Content="Запущенные" AutomationProperties.Name="Запущенные приложения"/>
        <controls:SectionButton x:Name="LaunchTab" Style="{StaticResource TvTab}" Click="LaunchClick" Content="Для запуска" AutomationProperties.Name="Программы для запуска"/>
      </StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Text="LB  RB   разделы" Foreground="{DynamicResource MutedText}" FontSize="16"/></Grid>
      <Grid x:Name="ControlSurface" Grid.Row="1" Margin="0,6,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,24"><TextBlock Text="Быстрое управление" FontSize="30"/><TextBlock Text="Звук и основной экран — без выхода на рабочий стол" Margin="0,7,0,0" Foreground="{DynamicResource MutedText}" FontSize="17"/></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
          <Button x:Name="AudioControlCard" Style="{StaticResource TvCard}" Click="AudioCardClick" AutomationProperties.Name="Выбрать устройство звука"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="♫" FontSize="30" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Звук" FontSize="16" Foreground="{DynamicResource MutedText}"/><TextBlock x:Name="AudioSummary" Text="Загрузка…" FontSize="25" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="A  изменить" FontSize="16" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/></Grid></Button>
          <Button x:Name="DisplayControlCard" Style="{StaticResource TvCard}" Click="DisplayCardClick" AutomationProperties.Name="Выбрать основной экран"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▣" FontSize="28" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Основной экран" FontSize="16" Foreground="{DynamicResource MutedText}"/><TextBlock x:Name="DisplaySummary" Text="Загрузка…" FontSize="25" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="A  изменить" FontSize="16" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/></Grid></Button>
        </StackPanel>
      </Grid>
      <controls:ProgramsView x:Name="Programs" Grid.Row="1" Margin="0,6,0,16" Visibility="Collapsed"/>
      <Border Grid.Row="2" BorderBrush="#4A5059" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid><TextBlock x:Name="Status" Text="Готово" FontSize="16" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel x:Name="ControllerHints" HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="PrimaryCommand" Content="A  выбрать" Click="PrimaryCommandClick"/><Button x:Name="SecondaryCommand" Content="X  действие" Click="SecondaryCommandClick"/><Button x:Name="CreateCommand" Content="Y  добавить" Click="CreateCommandClick"/><Button x:Name="SettingsCommand" Content="☰  настройки" Click="SettingsCommandClick"/><Button x:Name="BackCommand" Content="B  назад" Click="BackCommandClick"/></StackPanel></Grid></Border>
      <Grid x:Name="OverlayShade" Grid.RowSpan="3" Background="#A9080A0D" Visibility="Collapsed">
        <Border x:Name="DevicePickerOverlay" Style="{StaticResource OverlayCard}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="4,0,4,22"><TextBlock x:Name="PickerTitle" Text="Выберите устройство" FontSize="29"/><TextBlock x:Name="PickerSubtitle" Margin="0,7,0,0" Foreground="{DynamicResource MutedText}" FontSize="17"/></StackPanel><Grid Grid.Row="1"><ListBox x:Name="Devices" Background="Transparent" BorderThickness="0" Padding="0" PreviewMouseLeftButtonUp="ApplyMouseClick" AutomationProperties.Name="Доступные устройства"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="23" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayDetails}" FontSize="16" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Marker}" Margin="24,0,0,0" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" FontSize="15"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="Empty" Text="Нет доступных устройств" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Visibility="Collapsed"/></Grid></Grid></Border>
        <Border x:Name="SettingsSurface" Style="{StaticResource OverlayCard}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="4,0,4,22"><TextBlock Text="Настройки" FontSize="29"/><TextBlock Text="После переноса окна на главный экран" Foreground="{DynamicResource MutedText}" FontSize="17" Margin="0,7,0,0"/></StackPanel><ListBox x:Name="SettingsChoices" Grid.Row="1" Background="Transparent" BorderThickness="0" PreviewMouseLeftButtonUp="SettingsMouseClick" AutomationProperties.Name="Поведение после переноса"><ListBoxItem Tag="Keep"><StackPanel><TextBlock Text="Оставить AudioSwitcher открытым" FontSize="23"/><TextBlock Text="Окно переместится без передачи фокуса" Foreground="{DynamicResource MutedText}" FontSize="16" Margin="0,5,0,0"/></StackPanel></ListBoxItem><ListBoxItem Tag="Close"><StackPanel><TextBlock Text="Переключиться на приложение" FontSize="23"/><TextBlock Text="AudioSwitcher закроется после успешного переноса" Foreground="{DynamicResource MutedText}" FontSize="16" Margin="0,5,0,0"/></StackPanel></ListBoxItem></ListBox></Grid></Border>
        <Border x:Name="DetailsSurface" Style="{StaticResource OverlayCard}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Не удалось выполнить действие" FontSize="29" Margin="4,0,4,22"/><ScrollViewer x:Name="ErrorScroll" Grid.Row="1" Style="{StaticResource DeviceScrollViewer}"><TextBlock x:Name="FullError" TextWrapping="Wrap" FontSize="18" Foreground="{DynamicResource MutedText}"/></ScrollViewer></Grid></Border>
      </Grid>
    </Grid>
  </Border>
</Window>
