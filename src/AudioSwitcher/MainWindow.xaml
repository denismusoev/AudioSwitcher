<Window x:Class="AudioSwitcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AudioSwitcher.Controls"
        Title="AudioSwitcher" Width="640" Height="700" MinWidth="640" MaxWidth="640" MinHeight="700" MaxHeight="700" WindowStyle="None" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="{DynamicResource Font14}" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonDown="PointerDown" PreviewMouseLeftButtonUp="PointerUp" PreviewMouseMove="PointerMove" PreviewMouseRightButtonDown="IgnoreRightButton" PreviewMouseRightButtonUp="IgnoreRightButton">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8"/></WindowChrome.WindowChrome>
  <Border x:Name="WindowFrame" Background="{DynamicResource WindowSurface}" Padding="36,28,36,24" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="48"/><RowDefinition Height="24"/></Grid.RowDefinitions>
      <Grid x:Name="SectionHeader" Background="Transparent" Margin="0,0,0,16" Height="48">
        <StackPanel Orientation="Horizontal">
          <controls:SectionButton x:Name="AudioTab" Style="{StaticResource SectionTab}" Click="AudioClick" Margin="0,0,32,0" Content="Звук" AutomationProperties.Name="Звук"/>
          <controls:SectionButton x:Name="DisplayTab" Style="{StaticResource SectionTab}" Click="DisplayClick" Margin="0,0,32,0" Content="Мониторы" AutomationProperties.Name="Мониторы"/>
          <controls:SectionButton x:Name="ProgramsTab" Style="{StaticResource SectionTab}" Click="ProgramsClick" Content="Программы" AutomationProperties.Name="Программы"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="DeviceSurface" Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,20">
        <ListBox x:Name="Devices" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="ApplyMouseClick" AutomationProperties.Name="Устройства вывода">
          <ListBox.ItemsPanel><ItemsPanelTemplate><controls:DeviceRowsPanel ClipToBounds="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="DeviceScroll" Style="{StaticResource DeviceScrollViewer}" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
          <ListBox.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource DeviceScrollViewer}"/></ListBox.Resources>
          <ListBox.ItemTemplate><DataTemplate><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.ColumnSpan="2" Text="{Binding DisplayName}" FontSize="{DynamicResource Font22}" FontWeight="Normal" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="{Binding DisplayDetails}" Style="{StaticResource SecondaryText}" Margin="0,5,8,0" FontSize="{DynamicResource Font16}" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Top" ToolTip="{Binding Marker}">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="{Binding Marker}" Style="{StaticResource SecondaryText}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource Font14}"/>
            </StackPanel>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Text="Нет доступных устройств" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" Visibility="Collapsed"/>
      </Grid>
      <controls:ProgramsView x:Name="Programs" Margin="0,0,0,20" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>
      <Grid x:Name="DetailsSurface" Grid.Row="1" Visibility="Collapsed" Margin="12,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Подробности" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ScrollViewer x:Name="ErrorScroll" Grid.Row="1" Style="{StaticResource DeviceScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Подробные сведения"><TextBlock x:Name="FullError" TextWrapping="Wrap"/></ScrollViewer>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="19,8,19,0" Margin="0,-8,0,0"><Grid x:Name="StatusSurface" Height="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CatalogCommand" Content="Каталог" Padding="8,0" Click="CatalogCommandClick"/><Button x:Name="SaveCommand" Content="Сохранить" Padding="8,0" Click="SaveCommandClick"/><Button x:Name="BackCommand" Content="Назад" Padding="8,0" Click="BackCommandClick"/></StackPanel>
        <ScrollViewer Style="{StaticResource DeviceScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="Status" Foreground="{DynamicResource Text}" FontSize="{DynamicResource Font16}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
      </Grid></Border>
    </Grid>
  </Border>
</Window>

