<Window x:Class="AudioSwitcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AudioSwitcher.Controls"
        Title="AudioSwitcher" Width="480" Height="550" MinWidth="340" MinHeight="400" WindowStyle="None" ResizeMode="CanResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowSurface}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="OnKeyDown">
  <Window.Resources><Visibility x:Key="MarkerTextVisibility">Visible</Visibility></Window.Resources>
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="8"/></WindowChrome.WindowChrome>
  <Border Padding="20,24,20,20" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="DragWindow" Margin="0,0,0,16" MinHeight="44">
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
          <Button x:Name="AudioTab" Style="{StaticResource SectionTab}" Click="AudioClick" Margin="0,0,14,0" Content="Звук" AutomationProperties.Name="Звук"/>
          <Button x:Name="DisplayTab" Style="{StaticResource SectionTab}" Click="DisplayClick" Margin="0,0,14,0" Content="Мониторы" AutomationProperties.Name="Мониторы"/>
          <Button x:Name="ProgramsTab" Style="{StaticResource SectionTab}" Click="ProgramsClick" Content="Программы" AutomationProperties.Name="Программы"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="DeviceSurface" Grid.Row="1">
        <ListBox x:Name="Devices" Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ApplyDoubleClick" AutomationProperties.Name="Устройства вывода">
          <ListBox.ItemsPanel><ItemsPanelTemplate><controls:DeviceRowsPanel ClipToBounds="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="DeviceScroll" Style="{StaticResource DeviceScrollViewer}" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
          <ListBox.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource DeviceScrollViewer}"/></ListBox.Resources>
          <ListBox.ItemTemplate><DataTemplate><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Normal" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding DisplayDetails}" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Marker}">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Marker}" Foreground="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Visibility="{DynamicResource MarkerTextVisibility}"/>
            </StackPanel>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Text="Нет доступных устройств" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Visibility="Collapsed"/>
      </Grid>
      <controls:ProgramsView x:Name="Programs" Grid.Row="1" Visibility="Collapsed"/>
      <Grid x:Name="StatusSurface" Grid.Row="2" Margin="12,16,12,0" MinHeight="24">
        <TextBlock x:Name="Status" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="12,16,12,0" Padding="0,12,0,0">
        <WrapPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,8">
          <Border BorderBrush="{StaticResource MutedText}" BorderThickness="1" CornerRadius="9" Width="18" Height="18" Margin="0,0,6,0"><TextBlock Text="A" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="ApplyHint" FontSize="12" VerticalAlignment="Center" Text=" / Enter · Применить" AutomationProperties.Name="A / Enter · Применить"/>
        </StackPanel>
          <StackPanel x:Name="BackShortcut" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,8">
            <Border BorderBrush="{StaticResource MutedText}" BorderThickness="1" CornerRadius="9" Width="18" Height="18" Margin="0,0,6,0"><TextBlock Text="B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock x:Name="BackHint" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Text=" / Esc · Закрыть"/>
          </StackPanel>
          <TextBlock x:Name="SelectionHint" FontSize="12" Margin="0,0,18,8" VerticalAlignment="Center"><Run Text="↑ ↓  " Foreground="{StaticResource Text}"/><Run Text="Выбор" Foreground="{StaticResource MutedText}"/></TextBlock>
          <TextBlock x:Name="ListHint" FontSize="12" Margin="0,0,18,8" Foreground="{StaticResource MutedText}" Text="X · Сменить список" Visibility="Collapsed"/>
          <TextBlock x:Name="SectionHint" FontSize="12" Margin="0,0,0,8" VerticalAlignment="Center"><Run Text="← → / LB RB  " Foreground="{StaticResource Text}"/><Run Text="Раздел" Foreground="{StaticResource MutedText}"/></TextBlock>
        </WrapPanel>
      </Border>
      <ContentControl x:Name="ProgramModalHost" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
  </Border>
</Window>
