<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="Ps5FontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

  <Style x:Key="Ps5ScreenTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Ps5FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ps5ScreenTitleFontSize}"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
  </Style>
  <Style x:Key="Ps5SettingLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Ps5FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ps5SettingLabelFontSize}"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
  </Style>
  <Style x:Key="Ps5PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Ps5SettingLabel}">
    <Setter Property="FontSize" Value="{DynamicResource Ps5PageTitleFontSize}"/>
    <Setter Property="FontWeight" Value="350"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Ps5SettingValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Ps5FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ps5SettingValueFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5SecondaryText}"/>
  </Style>
</ResourceDictionary>
