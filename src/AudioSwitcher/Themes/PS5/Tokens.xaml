<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Ps5WindowBackground" Color="#090C15"/>
  <LinearGradientBrush x:Key="Ps5PanelSurface" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#F0343944" Offset="0"/>
    <GradientStop Color="#F0242933" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Ps5FocusedSurface" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="Ps5HoverSurface" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="Ps5PrimaryText" Color="#F5F6F8"/>
  <SolidColorBrush x:Key="Ps5SecondaryText" Color="#B9BEC8"/>
  <SolidColorBrush x:Key="Ps5Divider" Color="#20FFFFFF"/>
  <SolidColorBrush x:Key="Ps5FocusOutline" Color="#F8FAFF"/>
  <SolidColorBrush x:Key="Ps5FocusFlash" Color="#2EFFFFFF"/>
  <SolidColorBrush x:Key="Ps5ErrorText" Color="#E7AAA6"/>
  <SolidColorBrush x:Key="Ps5InputSurface" Color="#00FFFFFF"/>
  <SolidColorBrush x:Key="Ps5ToggleTrack" Color="#242733"/>
  <SolidColorBrush x:Key="Ps5ToggleThumbBorder" Color="#8C8E94"/>
  <SolidColorBrush x:Key="Ps5ToggleThumbOn" Color="#D4D4D4"/>
  <SolidColorBrush x:Key="Ps5ModalBackdropBrush" Color="#98080A0D"/>

  <Thickness x:Key="Ps5FocusThickness">3</Thickness>
  <Thickness x:Key="Ps5ListRowPadding">18,18,18,22</Thickness>
  <Thickness x:Key="Ps5ListSecondaryMargin">0,4,0,0</Thickness>
  <CornerRadius x:Key="Ps5FocusCornerRadius">2</CornerRadius>
  <sys:Double x:Key="Ps5SettingsRowHeight">72</sys:Double>
  <sys:Double x:Key="Ps5ListPrimarySlotHeight">32</sys:Double>
  <sys:Double x:Key="Ps5ListSecondarySlotHeight">24</sys:Double>
  <sys:Double x:Key="Ps5DrawerWidth">450</sys:Double>
  <sys:Double x:Key="Ps5ScreenTitleFontSize">36</sys:Double>
  <sys:Double x:Key="Ps5SettingLabelFontSize">24</sys:Double>
  <sys:Double x:Key="Ps5PageTitleFontSize">26</sys:Double>
  <sys:Double x:Key="Ps5SettingValueFontSize">18</sys:Double>
  <sys:Double x:Key="Ps5AccessoryFontSize">15</sys:Double>
</ResourceDictionary>
