<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AudioSwitcher.Controls">
  <Style x:Key="Ps5SettingsRow" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="18,8"/>
    <Setter Property="MinHeight" Value="{StaticResource Ps5SettingsRowHeight}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="FocusFrame"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{DynamicResource Ps5FocusThickness}"
                    CornerRadius="{DynamicResource Ps5FocusCornerRadius}"/>
            <Border x:Name="FocusFlash" Background="{DynamicResource Ps5FocusFlash}"
                    CornerRadius="{DynamicResource Ps5FocusCornerRadius}" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource Ps5FocusOutline}"/>
              <Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FocusFlash" Storyboard.TargetProperty="Opacity" From="0.18" To="0" Duration="{StaticResource Ps5MotionFlash}"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Ps5HoverSurface}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ps5SettingsCategory" TargetType="controls:SectionButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5SecondaryText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{StaticResource Ps5FontFamily}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="MinHeight" Value="80"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="23,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SectionButton">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="SelectionFrame" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{DynamicResource Ps5FocusThickness}"
                    CornerRadius="{DynamicResource Ps5FocusCornerRadius}"/>
            <Border x:Name="FocusFlash" Background="{DynamicResource Ps5FocusFlash}"
                    CornerRadius="{DynamicResource Ps5FocusCornerRadius}" Opacity="0"/>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="SectionMarker" Width="6" Height="6" Fill="{DynamicResource Ps5PrimaryText}"
                       Margin="0,0,13,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SectionMarker" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource Ps5FocusOutline}"/>
              <Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FocusFlash" Storyboard.TargetProperty="Opacity" From="0.18" To="0" Duration="{StaticResource Ps5MotionFlash}"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource Ps5HoverSurface}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ps5Toggle" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="MinHeight" Value="{StaticResource Ps5SettingsRowHeight}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                    BorderThickness="{DynamicResource Ps5FocusThickness}" CornerRadius="{DynamicResource Ps5FocusCornerRadius}"/>
            <Border x:Name="FocusFlash" Background="{DynamicResource Ps5FocusFlash}"
                    CornerRadius="{DynamicResource Ps5FocusCornerRadius}" Opacity="0"/>
            <Grid Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Переключаться на приложение" Style="{StaticResource Ps5SettingLabel}" TextWrapping="Wrap"/>
                <TextBlock Text="Для уже запущенных приложений; AudioSwitcher закроется после успешного переноса"
                           Style="{StaticResource Ps5SettingValue}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="21,0,0,0">
                <TextBlock x:Name="ToggleState" Text="Выкл." Style="{StaticResource Ps5SettingValue}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border x:Name="Track" Width="70" Height="28" CornerRadius="14" Background="#8C8C8C" VerticalAlignment="Center">
                  <Border x:Name="Thumb" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Ps5PrimaryText}"
                          HorizontalAlignment="Right" Margin="2" Opacity="0"/>
                </Border>
              </StackPanel>
              <Border Height="1" Background="{DynamicResource Ps5Divider}" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
              <Setter TargetName="ToggleState" Property="Text" Value="Вкл."/>
              <Setter TargetName="ToggleState" Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Ps5FocusOutline}"/>
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FocusFlash" Storyboard.TargetProperty="Opacity" From="0.18" To="0" Duration="{StaticResource Ps5MotionFlash}"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ps5HoverSurface}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
