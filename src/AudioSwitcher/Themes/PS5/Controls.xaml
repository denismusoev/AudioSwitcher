<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AudioSwitcher.Controls">
  <Style x:Key="Ps5AnimatedFocusBorder" TargetType="Border">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#343B49" Offset="0"/>
          <GradientStop Color="#F8FAFF" Offset="0.36"/>
          <GradientStop Color="#AAB4C7" Offset="0.58"/>
          <GradientStop Color="#242A35" Offset="1"/>
          <LinearGradientBrush.RelativeTransform>
            <RotateTransform CenterX="0.5" CenterY="0.5"/>
          </LinearGradientBrush.RelativeTransform>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
        <Setter Property="Opacity" Value="1"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"/>
          <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <MultiDataTrigger.EnterActions>
          <BeginStoryboard x:Name="StartPs5Border">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.1" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(Brush.RelativeTransform).(RotateTransform.Angle)"
                               From="0" To="359" Duration="0:0:4" RepeatBehavior="Forever"/>
            </Storyboard>
          </BeginStoryboard>
        </MultiDataTrigger.EnterActions>
        <MultiDataTrigger.ExitActions>
          <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.1"/></Storyboard></BeginStoryboard>
          <StopStoryboard BeginStoryboardName="StartPs5Border"/>
        </MultiDataTrigger.ExitActions>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Ps5GlassSweep" TargetType="Border">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Margin" Value="5"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Ps5FocusCornerRadius}"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" SpreadMethod="Pad">
          <GradientStop Color="Transparent" Offset="0"/>
          <GradientStop Color="Transparent" Offset="0.34"/>
          <GradientStop Color="#50FFFFFF" Offset="0.5"/>
          <GradientStop Color="Transparent" Offset="0.66"/>
          <GradientStop Color="Transparent" Offset="1"/>
          <LinearGradientBrush.RelativeTransform>
            <TranslateTransform X="-1.2"/>
          </LinearGradientBrush.RelativeTransform>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"/>
          <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <MultiDataTrigger.EnterActions>
          <BeginStoryboard x:Name="StartPs5Glass">
            <Storyboard RepeatBehavior="Forever" Duration="0:0:5">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                               From="-1.2" To="1.2" Duration="0:0:0.8"/>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:0.5" Duration="0:0:0.3"/>
            </Storyboard>
          </BeginStoryboard>
        </MultiDataTrigger.EnterActions>
        <MultiDataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="StartPs5Glass"/>
        </MultiDataTrigger.ExitActions>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Ps5SettingsRow" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="18,8"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="MinHeight" Value="{StaticResource Ps5SettingsRowHeight}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True" ClipToBounds="True">
            <Border x:Name="FocusFrame"
                    Style="{StaticResource Ps5AnimatedFocusBorder}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{DynamicResource Ps5FocusThickness}"
                    CornerRadius="{DynamicResource Ps5FocusCornerRadius}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            <Border x:Name="GlassSweep" Style="{StaticResource Ps5GlassSweep}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
              <Setter TargetName="FocusFrame" Property="Tag" Value="True"/>
              <Setter TargetName="GlassSweep" Property="Tag" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Ps5HoverSurface}"/>
              <Setter TargetName="FocusFrame" Property="Tag" Value="True"/>
              <Setter TargetName="GlassSweep" Property="Tag" Value="True"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ps5SettingsCategory" TargetType="controls:SectionButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5SecondaryText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{StaticResource Ps5FontFamily}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="MinHeight" Value="80"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="23,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SectionButton">
          <Grid SnapsToDevicePixels="True" ClipToBounds="True">
            <Border x:Name="SelectionFrame" Style="{StaticResource Ps5AnimatedFocusBorder}" Background="{TemplateBinding Background}"
                    BorderThickness="{DynamicResource Ps5FocusThickness}"
                    CornerRadius="{DynamicResource Ps5FocusCornerRadius}"/>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="SectionMarker" Width="6" Height="6" Fill="{DynamicResource Ps5PrimaryText}"
                       Margin="0,0,13,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="GlassSweep" Style="{StaticResource Ps5GlassSweep}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SectionMarker" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
              <Setter TargetName="SelectionFrame" Property="Tag" Value="True"/>
              <Setter TargetName="GlassSweep" Property="Tag" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SelectionFrame" Property="Background" Value="{DynamicResource Ps5HoverSurface}"/>
              <Setter TargetName="SelectionFrame" Property="Tag" Value="True"/>
              <Setter TargetName="GlassSweep" Property="Tag" Value="True"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ps5Toggle" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="MinHeight" Value="{StaticResource Ps5SettingsRowHeight}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid SnapsToDevicePixels="True" ClipToBounds="True">
            <Border x:Name="Row" Style="{StaticResource Ps5AnimatedFocusBorder}" Background="{TemplateBinding Background}"
                    BorderThickness="{DynamicResource Ps5FocusThickness}" CornerRadius="{DynamicResource Ps5FocusCornerRadius}"/>
            <Grid Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Переключаться на приложение" Style="{StaticResource Ps5SettingLabel}" TextWrapping="Wrap"/>
                <TextBlock Text="Для уже запущенных приложений; AudioSwitcher закроется после успешного переноса"
                           Style="{StaticResource Ps5SettingValue}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="21,0,0,0">
                <TextBlock x:Name="ToggleState" Text="Выкл." Style="{StaticResource Ps5SettingValue}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border x:Name="Track" Width="70" Height="28" CornerRadius="14" Background="#8C8C8C" VerticalAlignment="Center">
                  <Border x:Name="Thumb" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Ps5PrimaryText}"
                          HorizontalAlignment="Right" Margin="2" Opacity="0"/>
                </Border>
              </StackPanel>
            </Grid>
            <Border x:Name="GlassSweep" Style="{StaticResource Ps5GlassSweep}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
              <Setter TargetName="ToggleState" Property="Text" Value="Вкл."/>
              <Setter TargetName="ToggleState" Property="Foreground" Value="{DynamicResource Ps5PrimaryText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ps5FocusedSurface}"/>
              <Setter TargetName="Row" Property="Tag" Value="True"/>
              <Setter TargetName="GlassSweep" Property="Tag" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ps5HoverSurface}"/>
              <Setter TargetName="Row" Property="Tag" Value="True"/>
              <Setter TargetName="GlassSweep" Property="Tag" Value="True"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
