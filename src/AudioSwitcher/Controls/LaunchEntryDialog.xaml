<UserControl x:Class="AudioSwitcher.Controls.LaunchEntryDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AudioSwitcher.Controls" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" PreviewKeyDown="DialogKeyDown" KeyboardNavigation.TabNavigation="Cycle">
 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource FormInput}"><EventSetter Event="GotKeyboardFocus" Handler="InputFocused"/></Style>
  <Style TargetType="Label" BasedOn="{StaticResource FormLabel}"><Setter Property="FontSize" Value="{DynamicResource Font14}"/><Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style x:Key="Attribute" TargetType="Border"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="MinHeight" Value="82"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="CornerRadius" Value="4"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="17,12" MinHeight="82" Margin="0,0,0,6"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="EditorTitle" Text="Добавить программу" FontSize="{DynamicResource Font22}" TextTrimming="CharacterEllipsis"/><TextBlock Text="Каталог запуска" FontSize="{DynamicResource Font16}" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0"/></StackPanel></Border>
  <ScrollViewer Grid.Row="1" Style="{StaticResource DeviceScrollViewer}" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border x:Name="NameAttribute" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="NameLabel" Content="Название" Target="{Binding ElementName=EntryName}"/><TextBox x:Name="EntryName" AutomationProperties.Name="Название программы" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/></StackPanel></Border>
   <Border x:Name="TargetAttribute" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="TargetLabel" Content="Программа или ярлык" Target="{Binding ElementName=EntryTarget}"/><TextBox x:Name="EntryTarget" TextChanged="TargetChanged" AutomationProperties.Name="Путь к программе или ярлыку" AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}"/></StackPanel></Border>
   <TextBlock x:Name="ShortcutHint" Text="Параметры запуска задаются в самом ярлыке" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="17,0,17,12" Visibility="Collapsed"/>
   <StackPanel x:Name="ExecutableOptions">
    <Border x:Name="ArgumentsAttribute" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="ArgumentsLabel" Content="Аргументы (необязательно)" Target="{Binding ElementName=EntryArguments}"/><TextBox x:Name="EntryArguments" AutomationProperties.Name="Аргументы запуска" AutomationProperties.LabeledBy="{Binding ElementName=ArgumentsLabel}"/></StackPanel></Border>
    <Border x:Name="DirectoryAttribute" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="DirectoryLabel" Content="Рабочая папка (необязательно)" Target="{Binding ElementName=EntryDirectory}"/><TextBox x:Name="EntryDirectory" AutomationProperties.Name="Рабочая папка" AutomationProperties.LabeledBy="{Binding ElementName=DirectoryLabel}"/></StackPanel></Border>
   </StackPanel>
  </StackPanel></ScrollViewer>
  <TextBlock Grid.Row="2" x:Name="EditorError" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="17,8" AutomationProperties.LiveSetting="Polite"/>
  <Button x:Name="SaveEntry" Visibility="Collapsed" Content="Сохранить" Click="SaveClick"/>
 </Grid>
</UserControl>


