<UserControl x:Class="AudioSwitcher.Controls.LaunchEntryDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" PreviewKeyDown="DialogKeyDown" KeyboardNavigation.TabNavigation="Cycle">
 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource FormInput}"><EventSetter Event="GotKeyboardFocus" Handler="InputFocused"/></Style>
   <Style TargetType="Label" BasedOn="{StaticResource FormLabel}"><Setter Property="FontSize" Value="{DynamicResource Font24}"/><Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
   <Style x:Key="Attribute" TargetType="Border"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="MinHeight" Value="194"/><Setter Property="Padding" Value="28,22"/><Setter Property="Margin" Value="0,0,28,22"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Background" Value="Transparent"/><Setter Property="SnapsToDevicePixels" Value="True"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></Style.Triggers></Style>
 </UserControl.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock x:Name="EditorTitle" Text="Добавить программу" FontSize="42"/><TextBlock Text="Каталог запуска" FontSize="{DynamicResource Font28}" Foreground="{DynamicResource MutedText}" Margin="0,10,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="NameAttribute" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="NameLabel" Content="Название" Target="{Binding ElementName=EntryName}"/><TextBox x:Name="EntryName" AutomationProperties.Name="Название программы" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/></StackPanel></Border>
    <Border x:Name="TargetAttribute" Grid.Row="1" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="TargetLabel" Content="Программа или ярлык" Target="{Binding ElementName=EntryTarget}"/><TextBox x:Name="EntryTarget" TextChanged="TargetChanged" AutomationProperties.Name="Путь к программе или ярлыку" AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}"/><TextBlock x:Name="ShortcutHint" Text="Параметры задаются в ярлыке" FontSize="{DynamicResource Font20}" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel></Border>
   <StackPanel x:Name="ExecutableOptions" Grid.Column="1" Grid.RowSpan="2">
    <Border x:Name="ArgumentsAttribute" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="ArgumentsLabel" Content="Аргументы (необязательно)" Target="{Binding ElementName=EntryArguments}"/><TextBox x:Name="EntryArguments" AutomationProperties.Name="Аргументы запуска" AutomationProperties.LabeledBy="{Binding ElementName=ArgumentsLabel}"/></StackPanel></Border>
    <Border x:Name="DirectoryAttribute" Focusable="True" PreviewMouseLeftButtonDown="AttributeMouseDown" Style="{StaticResource Attribute}"><StackPanel VerticalAlignment="Center"><Label x:Name="DirectoryLabel" Content="Рабочая папка (необязательно)" Target="{Binding ElementName=EntryDirectory}"/><TextBox x:Name="EntryDirectory" AutomationProperties.Name="Рабочая папка" AutomationProperties.LabeledBy="{Binding ElementName=DirectoryLabel}"/></StackPanel></Border>
   </StackPanel>
  </Grid>
   <TextBlock Grid.Row="2" x:Name="EditorError" Foreground="{DynamicResource ErrorText}" FontSize="{DynamicResource Font24}" TextWrapping="Wrap" Margin="0,14" AutomationProperties.LiveSetting="Polite"/>
  <Button x:Name="SaveEntry" Visibility="Collapsed" Content="Сохранить" Click="SaveClick"/>
 </Grid>
</UserControl>
