<UserControl x:Class="AudioSwitcher.Controls.ProgramsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AudioSwitcher.Controls">
 <UserControl.Resources>
  <Style x:Key="NormalChoice" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/></Style>
  <Style x:Key="ModalChoice" TargetType="ListBoxItem" BasedOn="{StaticResource NormalChoice}"><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="close"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="close-window"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="close-all"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="delete"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="delete-entry"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ProgramModeTab" TargetType="Button" BasedOn="{StaticResource SectionTab}"><Setter Property="FontSize" Value="{DynamicResource Font28}"/><Setter Property="MinHeight" Value="40"/></Style>
  <DataTemplate x:Key="ProgramRow"><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Font38}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayDetails}" FontSize="{DynamicResource Font24}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="RunningRow"><TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Font38}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <DataTemplate x:Key="ActionRow"><TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Font38}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <Style x:Key="ProgramList" TargetType="ListBox"><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><local:DeviceRowsPanel ClipToBounds="True"/></ItemsPanelTemplate></Setter.Value></Setter><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="ItemTemplate" Value="{StaticResource ProgramRow}"/><Setter Property="ItemContainerStyle" Value="{StaticResource NormalChoice}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Style="{StaticResource DeviceScrollViewer}" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid x:Name="ViewRoot">
  <Grid x:Name="ListsSurface">
    <Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel VerticalAlignment="Top"><TextBlock x:Name="ListTitle" FontSize="26" FontWeight="350"/><TextBlock x:Name="ListSubtitle" Margin="0,6,0,0" FontSize="{DynamicResource Font28}" Foreground="{DynamicResource MutedText}"/></StackPanel>
    <ListBox x:Name="RunningList" Grid.Row="1" Style="{StaticResource ProgramList}" ItemTemplate="{StaticResource RunningRow}" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Запущенные пользовательские приложения"/>
    <ListBox x:Name="LaunchList" Grid.Row="1" Style="{StaticResource ProgramList}" Visibility="Collapsed" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Добавленные программы для запуска"/>
    <TextBlock x:Name="EmptyPrograms" Grid.Row="1" Margin="18,21,18,20" FontSize="{DynamicResource Font28}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel Visibility="Collapsed" Orientation="Horizontal">
   <local:SectionButton x:Name="RunningMode" Style="{StaticResource ProgramModeTab}" Content="Запущенные" Click="RunningClick" Margin="0,0,16,0" AutomationProperties.Name="Запущенные приложения"/>
   <local:SectionButton x:Name="LaunchMode" Style="{StaticResource ProgramModeTab}" Content="Для запуска" Click="LaunchClick" AutomationProperties.Name="Каталог для запуска"/>
  </StackPanel>
  <WrapPanel x:Name="CatalogTools" Visibility="Collapsed"><Button x:Name="AddProgram" Content="Добавить программу" Click="AddClick"/><Button x:Name="ResetCatalog" Content="Сбросить каталог" Click="ResetClick" Visibility="Collapsed"/></WrapPanel>
  <Grid x:Name="PanelSurface" Visibility="Collapsed">
    <Border x:Name="PanelContainer" CornerRadius="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="PanelCard" Padding="18,10" MinHeight="78"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PanelTitle" FontSize="{DynamicResource Font38}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PanelDescription" FontSize="{DynamicResource Font24}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ListBox x:Name="ProgramActions" Style="{StaticResource ProgramList}" ItemTemplate="{StaticResource ActionRow}" ItemContainerStyle="{StaticResource ModalChoice}" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Действия с выбранной программой"/>
      <TextBlock x:Name="PanelWarning" Grid.Row="1" Margin="18,11" FontSize="{DynamicResource Font24}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock x:Name="PanelFeedback" Grid.Row="2" FontSize="{DynamicResource Font24}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="18,9" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </Grid></Border>
  </Grid>
  <ContentControl x:Name="EditorHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</UserControl>

