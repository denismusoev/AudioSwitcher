<UserControl x:Class="AudioSwitcher.Controls.ProgramsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AudioSwitcher.Controls">
 <UserControl.Resources>
  <Style x:Key="NormalChoice" TargetType="ListBoxItem" BasedOn="{StaticResource Ps5ListItem}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/></Style>
  <Style x:Key="ModalChoice" TargetType="ListBoxItem" BasedOn="{StaticResource NormalChoice}"><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="close"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="close-window"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="close-all"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="delete"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="delete-entry"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ProgramModeTab" TargetType="local:SectionButton" BasedOn="{StaticResource Ps5SettingsCategory}"><Setter Property="MinHeight" Value="52"/></Style>
  <DataTemplate x:Key="ProgramRow"><StackPanel><TextBlock Text="{Binding DisplayName}" Style="{StaticResource Ps5SettingLabel}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayDetails}" Style="{StaticResource Ps5SettingValue}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="RunningRow"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource Ps5SettingLabel}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <DataTemplate x:Key="ActionRow"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource Ps5SettingLabel}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <Style x:Key="ProgramList" TargetType="ListBox" BasedOn="{StaticResource Ps5ListBox}"><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><local:DeviceRowsPanel ClipToBounds="True"/></ItemsPanelTemplate></Setter.Value></Setter><Setter Property="ItemTemplate" Value="{StaticResource ProgramRow}"/><Setter Property="ItemContainerStyle" Value="{StaticResource NormalChoice}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Style="{StaticResource DeviceScrollViewer}" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid x:Name="ViewRoot">
  <Grid x:Name="ListsSurface">
    <Grid.RowDefinitions><RowDefinition MinHeight="80" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid MinHeight="80"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ListTitle" Style="{StaticResource Ps5PageTitle}"/><TextBlock x:Name="ListSubtitle" Margin="0,6,0,0" Style="{StaticResource Ps5SettingValue}" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel></Grid>
    <ListBox x:Name="RunningList" Grid.Row="1" Style="{StaticResource ProgramList}" Margin="0,1,0,0" ItemTemplate="{StaticResource RunningRow}" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Запущенные пользовательские приложения"/>
    <ListBox x:Name="LaunchList" Grid.Row="1" Style="{StaticResource ProgramList}" Margin="0,1,0,0" Visibility="Collapsed" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Добавленные программы для запуска"/>
    <TextBlock x:Name="EmptyPrograms" Grid.Row="1" Margin="18,21,18,20" FontSize="{DynamicResource Font28}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel Visibility="Collapsed" Orientation="Horizontal">
   <local:SectionButton x:Name="RunningMode" Style="{StaticResource ProgramModeTab}" Content="Запущенные" Click="RunningClick" Margin="0,0,16,0" AutomationProperties.Name="Запущенные приложения"/>
   <local:SectionButton x:Name="LaunchMode" Style="{StaticResource ProgramModeTab}" Content="Для запуска" Click="LaunchClick" AutomationProperties.Name="Каталог для запуска"/>
  </StackPanel>
  <WrapPanel x:Name="CatalogTools" Visibility="Collapsed"><Button x:Name="AddProgram" Content="Добавить программу" Click="AddClick"/><Button x:Name="ResetCatalog" Content="Сбросить каталог" Click="ResetClick" Visibility="Collapsed"/></WrapPanel>
  <Grid x:Name="PanelSurface" Visibility="Collapsed">
    <Border x:Name="PanelContainer" CornerRadius="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="PanelCard" MinHeight="69"><StackPanel VerticalAlignment="Top"><TextBlock x:Name="PanelTitle" Style="{StaticResource Ps5SettingLabel}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PanelDescription" Style="{StaticResource Ps5SettingValue}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ListBox x:Name="ProgramActions" Style="{StaticResource ProgramList}" ItemTemplate="{StaticResource ActionRow}" ItemContainerStyle="{StaticResource ModalChoice}" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Действия с выбранной программой"/>
      <TextBlock x:Name="PanelWarning" Grid.Row="1" Margin="18,11" FontSize="{DynamicResource Font28}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock x:Name="PanelFeedback" Grid.Row="2" FontSize="{DynamicResource Font28}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="18,9" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </Grid></Border>
  </Grid>
  <ContentControl x:Name="EditorHost" Style="{StaticResource Ps5EmbeddedEditor}" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</UserControl>

