<UserControl x:Class="AudioSwitcher.Controls.ProgramsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ViewRoot">
  <Grid x:Name="ListsSurface">
    <Grid.RowDefinitions><RowDefinition MinHeight="80" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid MinHeight="80"><TextBlock x:Name="ListTitle" Style="{StaticResource Ps5PageTitle}" VerticalAlignment="Center"/></Grid>
    <ListBox x:Name="RunningList" Grid.Row="1" Style="{StaticResource Ps5ScrollableListBox}" Margin="0,1,0,0" ItemTemplate="{StaticResource Ps5OneLineRowTemplate}" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Запущенные пользовательские приложения"/>
    <ListBox x:Name="LaunchList" Grid.Row="1" Style="{StaticResource Ps5ScrollableListBox}" Margin="0,1,0,0" ItemTemplate="{StaticResource Ps5TwoLineRowTemplate}" Visibility="Collapsed" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Добавленные программы для запуска"/>
    <TextBlock x:Name="EmptyPrograms" Grid.Row="1" Margin="18,21,18,20" FontSize="{DynamicResource Font28}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" IsHitTestVisible="False"/>
  </Grid>
  <Grid x:Name="PanelSurface" Visibility="Collapsed">
    <Border x:Name="PanelContainer" CornerRadius="2" Background="Transparent" BorderThickness="0" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="PanelCard" MinHeight="80"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PanelTitle" Style="{StaticResource Ps5SettingLabel}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PanelDescription" Style="{StaticResource Ps5SettingValue}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ListBox x:Name="ProgramActions" Style="{StaticResource Ps5ScrollableListBox}" ItemTemplate="{StaticResource Ps5OneLineRowTemplate}" PreviewMouseLeftButtonDown="ListPress" PreviewMouseLeftButtonUp="ListClick" AutomationProperties.Name="Действия с выбранной программой"/>
      <TextBlock x:Name="PanelFeedback" Grid.Row="1" FontSize="{DynamicResource Font28}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="18,9" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </Grid></Border>
  </Grid>
  <ContentControl x:Name="EditorHost" Style="{StaticResource Ps5EmbeddedEditor}" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</UserControl>

